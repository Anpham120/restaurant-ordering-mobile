# Staging settings (branch develop). On the server this file is written from the Jenkins credential
# "ordering-staging-env" (base64 of the whole file) only while deploying. Never commit a real .env.
# Staging runs next to production but is fully isolated: own Compose project (so own database volume),
# own image names and own loopback ports. It has no public domain; reach it from the server or an SSH tunnel:
#   ssh -L 8185:127.0.0.1:8185 -L 8184:127.0.0.1:8184 <server>   then open http://127.0.0.1:8185

COMPOSE_PROJECT_NAME=ordering-staging
IMAGE_PREFIX=ordering-staging
BACKEND_PORT=8184
WEB_PORT=8185
APP_WEB_URL=http://127.0.0.1:8185
APP_API_URL=http://127.0.0.1:8184

# staging data is disposable: no pre-deploy backup (production backups must not be pushed out of the rotation)
BACKUP_ENABLED=false

POSTGRES_DB=atlas_staging
POSTGRES_USER=atlas
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48 (never reuse the production key)
APP_JWT_SECRET=
APP_ADMIN_PHONE=0900000000
APP_ADMIN_PASSWORD=

# sample menu + demo accounts (manager 0900000001 ... password Atlas@123): fine here, staging is not public
APP_SEED_DEMO=true

# real payments and mail stay off in staging
SEPAY_API_KEY=
SMTP_USERNAME=
SMTP_PASSWORD=
