// Atlas Restaurant – CSDL đặt món giao tận nhà (PostgreSQL)
// Dán toàn bộ file này vào https://dbdiagram.io/d để xem ERD.
// Nguồn: backend/src/main/resources/db/migration/V1__init.sql, V2__..., V3__...
// Trong CSDL thật, các kiểu Enum dưới đây được cài bằng varchar + CHECK; ràng buộc CHECK và
// unique index một phần được ghi trong note của từng bảng/cột.

Project atlas_restaurant {
  database_type: 'PostgreSQL'
  Note: '22 bảng, 32 khóa ngoại, chuẩn 3NF. Tổng tiền đơn, mã đơn, nội dung chuyển khoản không được lưu mà tính khi cần.'
}

// ===================================================================== enums
Enum role {
  CUSTOMER
  STAFF
  KITCHEN
  MANAGER
}

Enum order_status {
  AWAITING_PAYMENT [note: 'Chờ chuyển khoản']
  PENDING [note: 'Chờ xác nhận']
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

Enum discount_type {
  PERCENT
  AMOUNT
}

Enum payment_method {
  COD
  BANK_TRANSFER
}

Enum payment_status {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

Enum promotion_target {
  NONE
  MENU_ITEM
  CATEGORY
  VOUCHER
}

Enum notification_type {
  ORDER
  PAYMENT
  PROMOTION
}

// ===================================================================== people
Table users {
  id bigint [pk, increment]
  full_name varchar(100) [not null]
  phone varchar(15) [not null, unique, note: 'CHECK phone ~ ^[0-9]{9,15}$']
  email varchar(120) [unique]
  password_hash varchar(100) [not null, note: 'BCrypt']
  role role [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  token_version integer [not null, default: 0, note: 'Nằm trong JWT; tăng khi đổi/đặt lại mật khẩu để thu hồi mọi phiên']
  must_change_password boolean [not null, default: false]
  marketing_opt_in boolean [not null, default: true, note: 'Đồng ý nhận thông báo khuyến mãi']
  Note: 'Mọi tài khoản: khách hàng, nhân viên, bếp, quản lý'
}

Table password_reset_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  code_hash varchar(100) [not null, note: 'Bản băm của mã OTP 6 số']
  expires_at timestamp [not null, note: 'CHECK expires_at > created_at (10 phút)']
  failed_attempts integer [not null, default: 0, note: 'CHECK 0..10; hủy mã sau 5 lần sai']
  used_at timestamp
  created_at timestamp [not null]
  requested_ip varchar(45)
  indexes {
    (user_id, created_at) [name: 'ix_password_reset_tokens_user']
  }
}

Table delivery_zones {
  id bigint [pk, increment]
  name varchar(60) [not null, unique]
  delivery_fee "numeric(12,2)" [not null, note: 'CHECK >= 0']
  estimated_minutes integer [not null, note: 'CHECK 5..240']
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  Note: 'Khu vực giao (quận) và phí ship'
}

Table addresses {
  id bigint [pk, increment]
  user_id bigint [not null]
  zone_id bigint [not null]
  label varchar(40) [not null]
  recipient_name varchar(100) [not null]
  recipient_phone varchar(15) [not null]
  street varchar(200) [not null]
  note varchar(200)
  is_default boolean [not null, default: false, note: 'UNIQUE (user_id) WHERE is_default – tối đa 1 địa chỉ mặc định']
  created_at timestamp [not null]
  indexes {
    user_id
    zone_id
  }
}

// ===================================================================== menu
Table categories {
  id bigint [pk, increment]
  name varchar(60) [not null, unique]
  image_url varchar(500)
  sort_order integer [not null, default: 0]
}

Table menu_items {
  id bigint [pk, increment]
  category_id bigint [not null]
  name varchar(120) [not null, unique]
  description varchar(500)
  price "numeric(12,2)" [not null, note: 'CHECK >= 0']
  image_url varchar(500)
  is_available boolean [not null, default: true, note: 'Còn hàng hôm nay']
  is_active boolean [not null, default: true, note: 'Còn trong thực đơn (lưu trữ thay vì xóa)']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    category_id
  }
}

Table option_groups {
  id bigint [pk, increment]
  menu_item_id bigint [not null]
  name varchar(60) [not null]
  min_select integer [not null, default: 0]
  max_select integer [not null, default: 1, note: 'CHECK max_select >= min_select']
  sort_order integer [not null, default: 0]
  indexes {
    (menu_item_id, name) [unique]
  }
  Note: 'Nhóm tùy chọn của món: Size, Topping…'
}

Table options {
  id bigint [pk, increment]
  group_id bigint [not null]
  name varchar(60) [not null]
  price_delta "numeric(12,2)" [not null, default: 0, note: 'Giá cộng thêm, CHECK >= 0']
  is_available boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  indexes {
    (group_id, name) [unique]
    group_id
  }
}

Table favorites {
  user_id bigint [not null]
  menu_item_id bigint [not null]
  created_at timestamp [not null]
  indexes {
    (user_id, menu_item_id) [pk]
    menu_item_id
  }
}

Table cart_items {
  id bigint [pk, increment]
  user_id bigint [not null]
  menu_item_id bigint [not null]
  quantity integer [not null, note: 'CHECK 1..99']
  note varchar(200)
  updated_at timestamp [not null]
  indexes {
    user_id
    menu_item_id
  }
  Note: 'Giỏ hàng lưu trên máy chủ; cùng một món có thể ở 2 dòng nếu khác tùy chọn'
}

Table cart_item_options {
  cart_item_id bigint [not null]
  option_id bigint [not null]
  indexes {
    (cart_item_id, option_id) [pk]
    option_id
  }
}

// ===================================================================== promotions
Table vouchers {
  id bigint [pk, increment]
  code varchar(40) [not null, unique]
  description varchar(200)
  discount_type discount_type [not null]
  discount_value "numeric(12,2)" [not null, note: 'CHECK > 0 và <= 100 nếu PERCENT']
  max_discount "numeric(12,2)" [note: 'Trần giảm cho loại %']
  min_order "numeric(12,2)" [not null, default: 0]
  start_at timestamp
  end_at timestamp [note: 'CHECK end_at > start_at']
  usage_limit integer [note: 'Tổng lượt dùng']
  per_user_limit integer [note: 'Lượt dùng mỗi khách']
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
}

Table promotions {
  id bigint [pk, increment]
  title varchar(120) [not null]
  subtitle varchar(300)
  image_url varchar(500) [not null]
  target_type promotion_target [not null, default: 'NONE', note: 'CHECK đúng một khóa ngoại khớp với target_type']
  menu_item_id bigint
  category_id bigint
  voucher_id bigint
  start_at timestamp
  end_at timestamp
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  announce_at timestamp [note: 'Hẹn gửi thông báo (sau giờ yên lặng 21:00–08:00)']
  announced_at timestamp
  indexes {
    menu_item_id
    category_id
    voucher_id
    announce_at [name: 'ix_promotions_announce', note: 'WHERE announced_at IS NULL']
  }
  Note: 'Banner chương trình quảng bá của nhà hàng'
}

// ===================================================================== orders
Table orders {
  id bigint [pk, increment]
  customer_id bigint [not null]
  zone_id bigint [not null]
  voucher_id bigint
  status order_status [not null]
  recipient_name varchar(100) [not null, note: 'Chụp lại từ sổ địa chỉ lúc đặt']
  recipient_phone varchar(15) [not null]
  delivery_street varchar(200) [not null]
  delivery_note varchar(200)
  note varchar(300)
  delivery_fee "numeric(12,2)" [not null, note: 'Phí ship thực thu']
  discount_amount "numeric(12,2)" [not null, default: 0, note: 'Số tiền giảm thực tế']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  version bigint [not null, default: 0, note: 'Khóa lạc quan']
  indexes {
    (customer_id, created_at) [name: 'ix_orders_customer_created']
    (status, created_at) [name: 'ix_orders_status_created']
    zone_id
    voucher_id
  }
  Note: 'Tạm tính và tổng tiền tính từ order_items, không lưu'
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  menu_item_id bigint [not null]
  quantity integer [not null, note: 'CHECK 1..99']
  unit_price "numeric(12,2)" [not null, note: 'Giá gốc lúc đặt']
  note varchar(200)
  indexes {
    order_id
    menu_item_id
  }
}

Table order_item_options {
  order_item_id bigint [not null]
  option_id bigint [not null]
  price_delta "numeric(12,2)" [not null, note: 'Giá cộng thêm lúc đặt']
  indexes {
    (order_item_id, option_id) [pk]
    option_id
  }
}

Table order_status_history {
  id bigint [pk, increment]
  order_id bigint [not null]
  status order_status [not null]
  changed_by bigint [note: 'null = hệ thống (vd. quá hạn thanh toán)']
  note varchar(300)
  changed_at timestamp [not null]
  indexes {
    (order_id, changed_at)
    changed_by
  }
}

Table reviews {
  id bigint [pk, increment]
  order_item_id bigint [not null, unique]
  rating integer [not null, note: 'CHECK 1..5']
  comment varchar(500)
  created_at timestamp [not null]
}

// ===================================================================== payments
Table payments {
  id bigint [pk, increment]
  order_id bigint [not null, unique, note: 'Mỗi đơn đúng một thanh toán']
  method payment_method [not null]
  amount "numeric(12,2)" [not null, note: 'CHECK >= 0']
  status payment_status [not null, note: 'CHECK đã thanh toán ⇔ có paid_at']
  expires_at timestamp [note: 'Hạn chuyển khoản (chỉ BANK_TRANSFER)']
  paid_at timestamp
  confirmed_by bigint [note: 'Nhân viên thu COD / xác nhận tay']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    confirmed_by
    (status, expires_at)
  }
}

Table bank_transactions {
  id bigint [pk, increment]
  provider varchar(20) [not null, note: 'SEPAY']
  provider_txn_id bigint [not null]
  gateway varchar(60)
  account_number varchar(30)
  amount "numeric(14,2)" [not null, note: 'CHECK > 0']
  content varchar(500)
  reference_code varchar(100)
  transaction_date timestamp
  received_at timestamp [not null]
  payment_id bigint [note: 'null = không khớp đơn nào']
  note varchar(200)
  indexes {
    (provider, provider_txn_id) [unique, note: 'Chống ghi trùng khi SePay gửi lại']
    payment_id
    received_at
  }
}

// ===================================================================== notifications & settings
Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  type notification_type [not null]
  title varchar(120) [not null]
  body varchar(500) [not null]
  order_id bigint
  promotion_id bigint
  is_read boolean [not null, default: false]
  created_at timestamp [not null]
  indexes {
    (user_id, is_read, created_at)
    (user_id, type, created_at)
    order_id
    promotion_id
  }
}

Table store_settings {
  id smallint [pk, default: 1, note: 'CHECK id = 1 – bảng một dòng']
  store_name varchar(100) [not null]
  hotline varchar(15) [not null]
  store_address varchar(200) [not null]
  open_time time [not null]
  close_time time [not null, note: 'CHECK close_time > open_time']
  min_order_amount "numeric(12,2)" [not null, default: 0]
  is_accepting_orders boolean [not null, default: true]
  updated_at timestamp [not null]
  updated_by bigint
  bank_code varchar(20) [note: 'CHECK nhập đủ cả bank_code và bank_account']
  bank_account varchar(19)
  bank_holder varchar(80)
  transfer_timeout_minutes integer [not null, default: 15, note: 'CHECK 5..120']
  indexes {
    updated_by
  }
}

// ===================================================================== relationships (32)
Ref: addresses.user_id > users.id [delete: cascade]
Ref: addresses.zone_id > delivery_zones.id
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
Ref: menu_items.category_id > categories.id
Ref: option_groups.menu_item_id > menu_items.id [delete: cascade]
Ref: options.group_id > option_groups.id [delete: cascade]
Ref: favorites.user_id > users.id [delete: cascade]
Ref: favorites.menu_item_id > menu_items.id [delete: cascade]
Ref: cart_items.user_id > users.id [delete: cascade]
Ref: cart_items.menu_item_id > menu_items.id [delete: cascade]
Ref: cart_item_options.cart_item_id > cart_items.id [delete: cascade]
Ref: cart_item_options.option_id > options.id [delete: cascade]
Ref: promotions.menu_item_id > menu_items.id
Ref: promotions.category_id > categories.id
Ref: promotions.voucher_id > vouchers.id
Ref: orders.customer_id > users.id
Ref: orders.zone_id > delivery_zones.id
Ref: orders.voucher_id > vouchers.id
Ref: order_items.order_id > orders.id
Ref: order_items.menu_item_id > menu_items.id
Ref: order_item_options.order_item_id > order_items.id
Ref: order_item_options.option_id > options.id
Ref: order_status_history.order_id > orders.id
Ref: order_status_history.changed_by > users.id
Ref: reviews.order_item_id - order_items.id
Ref: payments.order_id - orders.id
Ref: payments.confirmed_by > users.id
Ref: bank_transactions.payment_id > payments.id
Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.order_id > orders.id
Ref: notifications.promotion_id > promotions.id [delete: set null]
Ref: store_settings.updated_by > users.id
