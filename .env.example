# Production settings. On the server this file is written from the Jenkins credential "ordering-prod-env"
# (base64 of the whole file) only while deploying. Never commit a real .env.

# Public domain (DNS A record -> this server). Web app at /, API at /api.
APP_DOMAIN=order.atlasplatform12.tech

# PostgreSQL (container-internal, not published)
POSTGRES_DB=ordering
POSTGRES_USER=ordering
# openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing key, at least 32 bytes:  openssl rand -base64 48
APP_JWT_SECRET=

# First manager account, created only while the users table is empty (min 8 chars)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# true = also load sample menu, tables T1-T5 and voucher WELCOME10 on an empty DB
APP_SEED_DEMO=false
