# Production settings. On the server this file is written from the Jenkins credential "ordering-prod-env"
# (base64 of the whole file) only while deploying. Never commit a real .env.

# Public domain (DNS A record -> this server). Web app at /, API at /api.
APP_DOMAIN=order.atlasplatform12.tech

# PostgreSQL (container-internal, not published)
POSTGRES_DB=atlas
POSTGRES_USER=atlas
# openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing key, at least 32 bytes:  openssl rand -base64 48
APP_JWT_SECRET=

# First manager account, created when no manager exists yet. Logs in with this phone number (min 8 char password).
APP_ADMIN_PHONE=0900000000
APP_ADMIN_PASSWORD=

# true = load the sample menu (19 dishes with photos) and vouchers WELCOME10/FREESHIP on an empty DB
APP_SEED_DEMO=true

# SePay webhook API key (my.sepay.vn → Webhooks → Kiểu chứng thực: API Key). Empty = transfers are only confirmed by staff.
# Webhook URL to register in SePay: https://<APP_DOMAIN>/api/payments/sepay/webhook
SEPAY_API_KEY=

# Mail server that sends forgot-password codes (any SMTP relay, port 587 + STARTTLS).
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_USERNAME=<SMTP login shown in Brevo, e.g. xxxx@smtp-brevo.com>
#         SMTP_PASSWORD=<SMTP key>        MAIL_FROM=<a sender address verified in Brevo>
# Gmail:  SMTP_HOST=smtp.gmail.com        SMTP_USERNAME=<address>  SMTP_PASSWORD=<App Password>  (MAIL_FROM optional)
# Empty SMTP_USERNAME = codes are only written to the backend log (never use that in production).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
